# Copy to .env and fill in. Never commit .env.
HERALD_DATABASE_URL=postgresql+psycopg://herald:herald@localhost:5432/herald
HERALD_REDIS_URL=redis://localhost:6379/0

# AI provider. Leave empty to run the pipeline with the offline fake model.
ANTHROPIC_API_KEY=

# Notifier: ntfy topic for owner alerts. Leave empty to log alerts instead.
HERALD_NTFY_URL=https://ntfy.sh
HERALD_NTFY_TOPIC=

# Mail connectors: Fernet key for mailbox credentials and OAuth state (Fernet.generate_key()).
HERALD_TOKEN_KEY=
# Mail connectors: public base URL of this API, for OAuth redirects and webhooks.
HERALD_PUBLIC_API_URL=http://localhost:8000
# Gmail: Google OAuth client ID.
HERALD_GOOGLE_CLIENT_ID=
# Gmail: Google OAuth client secret.
HERALD_GOOGLE_CLIENT_SECRET=
# Gmail: Pub/Sub topic, like projects/<project>/topics/herald-gmail.
HERALD_GMAIL_TOPIC=
# Gmail: audience expected in the Pub/Sub push JWT.
HERALD_GMAIL_PUSH_AUDIENCE=
# Gmail: service account email expected in the Pub/Sub push JWT.
HERALD_GMAIL_PUSH_SERVICE_ACCOUNT=
