# Copy to .env and fill in. Never commit .env.
HERALD_DATABASE_URL=postgresql+psycopg://herald:herald@localhost:5432/herald
HERALD_REDIS_URL=redis://localhost:6379/0

# AI provider: "anthropic" calls Claude, "fake" (the default) runs offline.
# HERALD_MODEL_PROVIDER=anthropic
# Needed when the provider is anthropic; startup fails without it.
ANTHROPIC_API_KEY=
# Claude model for triage and setup drafts. Defaults to claude-haiku-5-5.
# HERALD_MODEL_NAME=claude-haiku-5-5

# Log level for Herald's own lines (email arrival and each pipeline step). Default INFO.
# HERALD_LOG_LEVEL=DEBUG

# Shared secret the arq worker sends to the API's internal routes (at least 24 chars).
# Needed with HERALD_QUEUE=arq; make api, make worker and make docker-dev use a dev value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HERALD_INTERNAL_TOKEN=
# Where the worker reaches the API. Defaults to http://localhost:8000.
# HERALD_INTERNAL_API_URL=http://localhost:8000

# Mail connectors: Fernet key for mailbox credentials and OAuth state (Fernet.generate_key()).
HERALD_TOKEN_KEY=
# Mail connectors: public base URL of this API, for OAuth redirects and webhooks.
HERALD_PUBLIC_API_URL=http://localhost:8000
# Gmail: Google OAuth client ID.
HERALD_GOOGLE_CLIENT_ID=
# Gmail: Google OAuth client secret.
HERALD_GOOGLE_CLIENT_SECRET=
# Gmail: Pub/Sub topic, like projects/<project>/topics/herald-gmail.
HERALD_GMAIL_TOPIC=
# Gmail: audience expected in the Pub/Sub push JWT.
HERALD_GMAIL_PUSH_AUDIENCE=
# Gmail: service account email expected in the Pub/Sub push JWT.
HERALD_GMAIL_PUSH_SERVICE_ACCOUNT=

# Production (infra/docker-compose.prod.yml). It sets the database and Redis URLs itself.
# It uses the anthropic model unless HERALD_MODEL_PROVIDER says otherwise.
POSTGRES_PASSWORD=
# Public URL of the web app, used in alert links.
# HERALD_WEB_URL=https://herald.example.com
# HERALD_PORT=8080
