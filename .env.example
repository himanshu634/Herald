# Copy to .env and fill in. Never commit .env.
HERALD_DATABASE_URL=postgresql+psycopg://herald:herald@localhost:5432/herald
HERALD_REDIS_URL=redis://localhost:6379/0

# AI provider. Leave empty to run the pipeline with the offline fake model.
ANTHROPIC_API_KEY=

# Notifier: ntfy topic for owner alerts. Leave empty to log alerts instead.
HERALD_NTFY_URL=https://ntfy.sh
HERALD_NTFY_TOPIC=

# Production (docker-compose.prod.yml). It sets the database and Redis URLs itself.
# It uses the anthropic model unless HERALD_MODEL_PROVIDER says otherwise.
POSTGRES_PASSWORD=
# Public URL of the web app, used in alert links.
# HERALD_WEB_URL=https://herald.example.com
# HERALD_PORT=8080
